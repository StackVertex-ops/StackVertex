# OverCloud Backend - Production Environment
# SECURITY: Never commit this file to git!

# CRITICAL: Set DEBUG=false in Production!
DEBUG=false
ENV=production

# Server (bind to localhost only, use reverse proxy)
HOST=127.0.0.1
PORT=8000

# CORS Origins (Production domains only)
CORS_ORIGINS=https://app.overcloud.io,https://overcloud.io

# Database
DATABASE_URL=postgresql://user:pass@production-host:5432/overcloud

# DynamoDB
DYNAMODB_TABLE_NAME=overcloud-prod-main
DYNAMODB_ENDPOINT_URL=

# S3
S3_LARGE_ITEMS_BUCKET=overcloud-prod-large-items
AWS_REGION=us-east-1

# Security (MUST be set!)
SECRET_KEY=bOlvA3a2pM3V-wh-kd6Uo4JmMkdyGi9OrmPdFIZAnyQ0l3kwQH6w-lt7JBhL-SfWx3yAs4cciCQIAb5hOC95Ng
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_ENABLED=true

# Logging
LOG_LEVEL=INFO
LOG_JSON_FORMAT=true
ENABLE_CLOUDWATCH=true
ENABLE_SENTRY=true
SENTRY_DSN=https://xxx@sentry.io/xxx

# Testing
TESTING=false
