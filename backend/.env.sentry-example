# Sentry Error Tracking Configuration
# Copy these lines to your .env file and replace with your actual Sentry DSN

# Enable Sentry
ENABLE_SENTRY=true

# Sentry DSN (from sentry.io → Project Settings → Client Keys (DSN))
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Environment (affects how errors are tagged in Sentry)
ENV=development  # or: staging, production

# Optional: Release Tracking
# SENTRY_RELEASE=overcloud-backend@v1.0.0
