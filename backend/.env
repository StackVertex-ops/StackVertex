# OverCloud Backend - Environment Variables
# Development Configuration mit SQLite

# App Settings
DEBUG=True

# Database (SQLite für Development - später PostgreSQL)
DATABASE_URL=sqlite:///./overcloud.db

# AWS Credentials (optional - use IAM roles in production)
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# Security (CHANGE IN PRODUCTION!)
SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Origins (JSON Array)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
