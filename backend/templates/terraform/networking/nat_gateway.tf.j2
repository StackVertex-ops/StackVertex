# NAT Gateway: {{ name }}
# Generated by OverCloud

{% if not config.eip_allocation_id %}
# Elastic IP for NAT Gateway
resource "aws_eip" "{{ id | tf_identifier }}" {
  domain = "vpc"

  tags = {
    Name        = "{{ name }} EIP"
    Environment = var.environment
    ManagedBy   = "OverCloud"
  }
}
{% endif %}

resource "aws_nat_gateway" "{{ id | tf_identifier }}" {
  allocation_id = {{ config.eip_allocation_id | default('aws_eip.' ~ id ~ '.id') }}
  subnet_id     = {{ config.subnet_id | default('aws_subnet.public.id') }}

  tags = {
    Name        = "{{ name }}"
    Environment = var.environment
    ManagedBy   = "OverCloud"
  }
}
