# Route Table: {{ name }}
# Generated by OverCloud

resource "aws_route_table" "{{ id | tf_identifier }}" {
  vpc_id = {{ config.vpc_id | default('aws_vpc.main.id') }}

  {% if config.routes %}
  {% for route in config.routes %}
  route {
    cidr_block = "{{ route.cidr_block }}"
    {% if route.gateway_id %}
    gateway_id = {{ route.gateway_id }}
    {% elif route.nat_gateway_id %}
    nat_gateway_id = {{ route.nat_gateway_id }}
    {% elif route.instance_id %}
    instance_id = {{ route.instance_id }}
    {% endif %}
  }
  {% endfor %}
  {% endif %}

  tags = {
    Name        = "{{ name }}"
    Environment = var.environment
    ManagedBy   = "OverCloud"
  }
}

{% if config.subnet_associations %}
# Route Table Associations
{% for subnet_id in config.subnet_associations %}
resource "aws_route_table_association" "{{ id | tf_identifier }}_{{ loop.index }}" {
  subnet_id      = {{ subnet_id }}
  route_table_id = aws_route_table.{{ id | tf_identifier }}.id
}
{% endfor %}
{% endif %}
