# Subnet: {{ name }}
# Generated by OverCloud

resource "aws_subnet" "{{ id | tf_identifier }}" {
  vpc_id                  = {{ config.vpc_id | default('aws_vpc.main.id') }}
  cidr_block              = "{{ config.cidr_block | default('10.0.1.0/24') }}"
  availability_zone       = "{{ config.availability_zone | default(metadata.region ~ 'a') }}"
  map_public_ip_on_launch = {{ config.map_public_ip_on_launch | default(false) | tf_bool }}

  tags = {
    Name        = "{{ name }}"
    Type        = "{{ config.type | default('private') }}"
    Environment = var.environment
    ManagedBy   = "OverCloud"
  }
}
