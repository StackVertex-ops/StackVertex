# VPC: {{ name }}
# Generated by OverCloud

resource "aws_vpc" "{{ id | tf_identifier }}" {
  cidr_block           = "{{ config.cidr_block | default('10.0.0.0/16') }}"
  enable_dns_hostnames = {{ config.enable_dns_hostnames | default(true) | tf_bool }}
  enable_dns_support   = {{ config.enable_dns_support | default(true) | tf_bool }}

  tags = {
    Name        = "{{ name }}"
    Environment = var.environment
    ManagedBy   = "OverCloud"
  }
}
