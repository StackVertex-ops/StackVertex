# Security Group: {{ name }}
# Generated by OverCloud

resource "aws_security_group" "{{ id | tf_identifier }}" {
  name        = "{{ config.group_name | default(name) }}"
  description = "{{ config.description | default('Security group for ' ~ name) }}"
  vpc_id      = {{ config.vpc_id | default('aws_vpc.main.id') }}

  {% if config.ingress_rules %}
  # Ingress Rules
  {% for rule in config.ingress_rules %}
  ingress {
    description = "{{ rule.description | default('Ingress rule') }}"
    from_port   = {{ rule.from_port }}
    to_port     = {{ rule.to_port }}
    protocol    = "{{ rule.protocol | default('tcp') }}"
    cidr_blocks = {{ rule.cidr_blocks | default(['0.0.0.0/0']) | tf_list }}
  }
  {% endfor %}
  {% else %}
  # Default: Allow HTTP and HTTPS
  ingress {
    description = "HTTP"
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    description = "HTTPS"
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }
  {% endif %}

  {% if config.egress_rules %}
  # Egress Rules
  {% for rule in config.egress_rules %}
  egress {
    description = "{{ rule.description | default('Egress rule') }}"
    from_port   = {{ rule.from_port }}
    to_port     = {{ rule.to_port }}
    protocol    = "{{ rule.protocol | default('tcp') }}"
    cidr_blocks = {{ rule.cidr_blocks | default(['0.0.0.0/0']) | tf_list }}
  }
  {% endfor %}
  {% else %}
  # Default: Allow all outbound
  egress {
    description = "Allow all outbound"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
  {% endif %}

  tags = {
    Name        = "{{ name }}"
    Environment = var.environment
    ManagedBy   = "OverCloud"
  }
}
