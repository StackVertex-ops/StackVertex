# RDS Database Instance: {{ name }}
# Generated by OverCloud

resource "aws_db_instance" "{{ id | tf_identifier }}" {
  identifier = "{{ config.identifier | default(name | tf_identifier) }}"

  # Engine Configuration
  engine         = "{{ config.engine | default('postgres') }}"
  engine_version = "{{ config.engine_version | default('15.3') }}"

  # Instance Configuration
  instance_class    = "{{ config.instance_class | default('db.t3.micro') }}"
  allocated_storage = {{ config.allocated_storage | default(20) }}
  storage_type      = "{{ config.storage_type | default('gp3') }}"

  {% if config.storage_encrypted %}
  storage_encrypted = {{ config.storage_encrypted | tf_bool }}
  {% endif %}

  # Database Configuration
  db_name  = "{{ config.db_name | default(name | tf_identifier) }}"
  username = "{{ config.username | default('admin') }}"
  password = "{{ config.password | default('ChangeMe123!') }}"  # TODO: Use secrets manager

  {% if config.parameter_group_name %}
  parameter_group_name = "{{ config.parameter_group_name }}"
  {% endif %}

  # Network Configuration
  {% if config.db_subnet_group_name %}
  db_subnet_group_name = "{{ config.db_subnet_group_name }}"
  {% endif %}

  {% if config.vpc_security_group_ids %}
  vpc_security_group_ids = {{ config.vpc_security_group_ids | tf_list }}
  {% endif %}

  publicly_accessible = {{ config.publicly_accessible | default(false) | tf_bool }}

  # Backup Configuration
  backup_retention_period = {{ config.backup_retention_period | default(7) }}
  backup_window          = "{{ config.backup_window | default('03:00-04:00') }}"
  maintenance_window     = "{{ config.maintenance_window | default('Mon:04:00-Mon:05:00') }}"

  # High Availability
  multi_az = {{ config.multi_az | default(false) | tf_bool }}

  # Deletion Protection
  deletion_protection = {{ config.deletion_protection | default(false) | tf_bool }}
  skip_final_snapshot = {{ config.skip_final_snapshot | default(true) | tf_bool }}

  {% if not config.skip_final_snapshot %}
  final_snapshot_identifier = "{{ name | tf_identifier }}-final-snapshot"
  {% endif %}

  tags = {
    Name        = "{{ name }}"
    Environment = var.environment
    ManagedBy   = "OverCloud"
  }
}
