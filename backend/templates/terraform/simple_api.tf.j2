# ============================================================================
# Simple REST API - API Gateway + Lambda + DynamoDB
# ============================================================================
# Generated by OverCloud
# Blueprint: {{ blueprint_id }}
# Created: {{ created_at }}

terraform {
  required_version = ">= 1.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }

  backend "s3" {
    bucket         = "{{ state_bucket_name }}"
    key            = "{{ project_name }}/terraform.tfstate"
    region         = "{{ aws_region }}"
    encrypt        = true
    dynamodb_table = "terraform-locks"
  }
}

provider "aws" {
  region = var.aws_region

  default_tags {
    tags = {
      Project     = "{{ project_name }}"
      Environment = var.environment
      ManagedBy   = "OverCloud"
      Blueprint   = "simple-api"
      CreatedAt   = "{{ created_at }}"
    }
  }
}

# ============================================================================
# Variables
# ============================================================================

variable "aws_region" {
  description = "AWS Region"
  type        = string
  default     = "us-east-1"
}

variable "environment" {
  description = "Environment (dev, staging, prod)"
  type        = string
  default     = "prod"
}

variable "api_name" {
  description = "API Name"
  type        = string
  default     = "{{ api_name }}"
}

variable "lambda_runtime" {
  description = "Lambda Runtime"
  type        = string
  default     = "{{ lambda_runtime }}"
}

variable "lambda_memory_mb" {
  description = "Lambda Memory (MB)"
  type        = number
  default     = {{ lambda_memory_mb }}
}

variable "lambda_timeout_seconds" {
  description = "Lambda Timeout (seconds)"
  type        = number
  default     = {{ lambda_timeout_seconds }}
}

variable "dynamodb_table_name" {
  description = "DynamoDB Table Name"
  type        = string
  default     = "{{ dynamodb_table_name }}"
}

variable "dynamodb_billing_mode" {
  description = "DynamoDB Billing Mode"
  type        = string
  default     = "{{ dynamodb_billing_mode }}"
}

variable "enable_cors" {
  description = "Enable CORS"
  type        = bool
  default     = {{ enable_cors | default(true) | lower }}
}

variable "api_key_required" {
  description = "Require API Key"
  type        = bool
  default     = {{ api_key_required | default(false) | lower }}
}

variable "enable_cloudwatch_logs" {
  description = "Enable CloudWatch Logs"
  type        = bool
  default     = {{ enable_cloudwatch_logs | default(true) | lower }}
}

# ============================================================================
# DynamoDB Table
# ============================================================================

resource "aws_dynamodb_table" "main" {
  name           = var.dynamodb_table_name
  billing_mode   = var.dynamodb_billing_mode
  hash_key       = "id"
  range_key      = "timestamp"

  # Hash Key
  attribute {
    name = "id"
    type = "S"
  }

  # Range Key
  attribute {
    name = "timestamp"
    type = "N"
  }

  # GSI für Timestamp-basierte Queries
  attribute {
    name = "status"
    type = "S"
  }

  global_secondary_index {
    name            = "StatusTimestampIndex"
    hash_key        = "status"
    range_key       = "timestamp"
    projection_type = "ALL"
  }

  # TTL für automatisches Löschen alter Einträge
  ttl {
    attribute_name = "expires_at"
    enabled        = true
  }

  # Point-in-Time Recovery für Backups
  point_in_time_recovery {
    enabled = true
  }

  # Server-Side Encryption
  server_side_encryption {
    enabled = true
  }

  tags = {
    Name = var.dynamodb_table_name
  }
}

# ============================================================================
# Lambda IAM Role
# ============================================================================

resource "aws_iam_role" "lambda" {
  name = "${var.api_name}-lambda-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Action = "sts:AssumeRole"
        Effect = "Allow"
        Principal = {
          Service = "lambda.amazonaws.com"
        }
      }
    ]
  })
}

# CloudWatch Logs Permission
resource "aws_iam_role_policy_attachment" "lambda_basic" {
  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
  role       = aws_iam_role.lambda.name
}

# DynamoDB Access Policy
resource "aws_iam_role_policy" "lambda_dynamodb" {
  name = "${var.api_name}-lambda-dynamodb"
  role = aws_iam_role.lambda.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect = "Allow"
        Action = [
          "dynamodb:GetItem",
          "dynamodb:PutItem",
          "dynamodb:UpdateItem",
          "dynamodb:DeleteItem",
          "dynamodb:Query",
          "dynamodb:Scan",
          "dynamodb:BatchGetItem",
          "dynamodb:BatchWriteItem"
        ]
        Resource = [
          aws_dynamodb_table.main.arn,
          "${aws_dynamodb_table.main.arn}/index/*"
        ]
      }
    ]
  })
}

# ============================================================================
# Lambda Functions (CRUD Operations)
# ============================================================================

resource "aws_cloudwatch_log_group" "lambda_get" {
  count             = var.enable_cloudwatch_logs ? 1 : 0
  name              = "/aws/lambda/${var.api_name}-get"
  retention_in_days = 7
}

resource "aws_lambda_function" "get" {
  filename         = "${path.module}/lambda_placeholder.zip"
  function_name    = "${var.api_name}-get"
  role             = aws_iam_role.lambda.arn
  handler          = "index.handler"
  source_code_hash = filebase64sha256("${path.module}/lambda_placeholder.zip")
  runtime          = var.lambda_runtime
  memory_size      = var.lambda_memory_mb
  timeout          = var.lambda_timeout_seconds

  environment {
    variables = {
      DYNAMODB_TABLE = aws_dynamodb_table.main.name
      OPERATION      = "GET"
    }
  }

  depends_on = [aws_iam_role_policy_attachment.lambda_basic]
}

resource "aws_cloudwatch_log_group" "lambda_post" {
  count             = var.enable_cloudwatch_logs ? 1 : 0
  name              = "/aws/lambda/${var.api_name}-post"
  retention_in_days = 7
}

resource "aws_lambda_function" "post" {
  filename         = "${path.module}/lambda_placeholder.zip"
  function_name    = "${var.api_name}-post"
  role             = aws_iam_role.lambda.arn
  handler          = "index.handler"
  source_code_hash = filebase64sha256("${path.module}/lambda_placeholder.zip")
  runtime          = var.lambda_runtime
  memory_size      = var.lambda_memory_mb
  timeout          = var.lambda_timeout_seconds

  environment {
    variables = {
      DYNAMODB_TABLE = aws_dynamodb_table.main.name
      OPERATION      = "POST"
    }
  }

  depends_on = [aws_iam_role_policy_attachment.lambda_basic]
}

resource "aws_cloudwatch_log_group" "lambda_put" {
  count             = var.enable_cloudwatch_logs ? 1 : 0
  name              = "/aws/lambda/${var.api_name}-put"
  retention_in_days = 7
}

resource "aws_lambda_function" "put" {
  filename         = "${path.module}/lambda_placeholder.zip"
  function_name    = "${var.api_name}-put"
  role             = aws_iam_role.lambda.arn
  handler          = "index.handler"
  source_code_hash = filebase64sha256("${path.module}/lambda_placeholder.zip")
  runtime          = var.lambda_runtime
  memory_size      = var.lambda_memory_mb
  timeout          = var.lambda_timeout_seconds

  environment {
    variables = {
      DYNAMODB_TABLE = aws_dynamodb_table.main.name
      OPERATION      = "PUT"
    }
  }

  depends_on = [aws_iam_role_policy_attachment.lambda_basic]
}

resource "aws_cloudwatch_log_group" "lambda_delete" {
  count             = var.enable_cloudwatch_logs ? 1 : 0
  name              = "/aws/lambda/${var.api_name}-delete"
  retention_in_days = 7
}

resource "aws_lambda_function" "delete" {
  filename         = "${path.module}/lambda_placeholder.zip"
  function_name    = "${var.api_name}-delete"
  role             = aws_iam_role.lambda.arn
  handler          = "index.handler"
  source_code_hash = filebase64sha256("${path.module}/lambda_placeholder.zip")
  runtime          = var.lambda_runtime
  memory_size      = var.lambda_memory_mb
  timeout          = var.lambda_timeout_seconds

  environment {
    variables = {
      DYNAMODB_TABLE = aws_dynamodb_table.main.name
      OPERATION      = "DELETE"
    }
  }

  depends_on = [aws_iam_role_policy_attachment.lambda_basic]
}

# ============================================================================
# API Gateway (REST API)
# ============================================================================

resource "aws_api_gateway_rest_api" "main" {
  name        = var.api_name
  description = "Simple REST API managed by OverCloud"

  endpoint_configuration {
    types = ["REGIONAL"]
  }
}

# API Gateway Resource: /items
resource "aws_api_gateway_resource" "items" {
  rest_api_id = aws_api_gateway_rest_api.main.id
  parent_id   = aws_api_gateway_rest_api.main.root_resource_id
  path_part   = "items"
}

# API Gateway Resource: /items/{id}
resource "aws_api_gateway_resource" "item" {
  rest_api_id = aws_api_gateway_rest_api.main.id
  parent_id   = aws_api_gateway_resource.items.id
  path_part   = "{id}"
}

# ============================================================================
# API Gateway Methods & Integrations
# ============================================================================

# GET /items (List all)
resource "aws_api_gateway_method" "get_items" {
  rest_api_id   = aws_api_gateway_rest_api.main.id
  resource_id   = aws_api_gateway_resource.items.id
  http_method   = "GET"
  authorization = "NONE"
  api_key_required = var.api_key_required
}

resource "aws_api_gateway_integration" "get_items" {
  rest_api_id             = aws_api_gateway_rest_api.main.id
  resource_id             = aws_api_gateway_resource.items.id
  http_method             = aws_api_gateway_method.get_items.http_method
  integration_http_method = "POST"
  type                    = "AWS_PROXY"
  uri                     = aws_lambda_function.get.invoke_arn
}

# POST /items (Create)
resource "aws_api_gateway_method" "post_items" {
  rest_api_id   = aws_api_gateway_rest_api.main.id
  resource_id   = aws_api_gateway_resource.items.id
  http_method   = "POST"
  authorization = "NONE"
  api_key_required = var.api_key_required
}

resource "aws_api_gateway_integration" "post_items" {
  rest_api_id             = aws_api_gateway_rest_api.main.id
  resource_id             = aws_api_gateway_resource.items.id
  http_method             = aws_api_gateway_method.post_items.http_method
  integration_http_method = "POST"
  type                    = "AWS_PROXY"
  uri                     = aws_lambda_function.post.invoke_arn
}

# GET /items/{id} (Get by ID)
resource "aws_api_gateway_method" "get_item" {
  rest_api_id   = aws_api_gateway_rest_api.main.id
  resource_id   = aws_api_gateway_resource.item.id
  http_method   = "GET"
  authorization = "NONE"
  api_key_required = var.api_key_required
}

resource "aws_api_gateway_integration" "get_item" {
  rest_api_id             = aws_api_gateway_rest_api.main.id
  resource_id             = aws_api_gateway_resource.item.id
  http_method             = aws_api_gateway_method.get_item.http_method
  integration_http_method = "POST"
  type                    = "AWS_PROXY"
  uri                     = aws_lambda_function.get.invoke_arn
}

# PUT /items/{id} (Update)
resource "aws_api_gateway_method" "put_item" {
  rest_api_id   = aws_api_gateway_rest_api.main.id
  resource_id   = aws_api_gateway_resource.item.id
  http_method   = "PUT"
  authorization = "NONE"
  api_key_required = var.api_key_required
}

resource "aws_api_gateway_integration" "put_item" {
  rest_api_id             = aws_api_gateway_rest_api.main.id
