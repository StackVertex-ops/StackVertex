# ============================================================================
# API Gateway Deployment & Stage
# ============================================================================

resource "aws_api_gateway_deployment" "prod" {
  rest_api_id = aws_api_gateway_rest_api.main.id

  depends_on = [
    aws_api_gateway_integration.get_items,
    aws_api_gateway_integration.post_items,
    aws_api_gateway_integration.get_item,
    aws_api_gateway_integration.put_item,
    aws_api_gateway_integration.delete_item
  ]

  lifecycle {
    create_before_destroy = true
  }
}

resource "aws_api_gateway_stage" "prod" {
  deployment_id = aws_api_gateway_deployment.prod.id
  rest_api_id   = aws_api_gateway_rest_api.main.id
  stage_name    = "prod"

  access_log_settings {
    destination_arn = var.enable_cloudwatch_logs ? aws_cloudwatch_log_group.api_gateway[0].arn : null
    format = jsonencode({
      requestId      = "$context.requestId"
      ip             = "$context.identity.sourceIp"
      requestTime    = "$context.requestTime"
      httpMethod     = "$context.httpMethod"
      resourcePath   = "$context.resourcePath"
      status         = "$context.status"
      protocol       = "$context.protocol"
      responseLength = "$context.responseLength"
    })
  }
}

resource "aws_cloudwatch_log_group" "api_gateway" {
  count             = var.enable_cloudwatch_logs ? 1 : 0
  name              = "/aws/apigateway/${var.api_name}"
  retention_in_days = 7
}

# Lambda Permissions für API Gateway
resource "aws_lambda_permission" "api_gateway_get" {
  statement_id  = "AllowAPIGatewayInvoke"
  action        = "lambda:InvokeFunction"
  function_name = aws_lambda_function.get.function_name
  principal     = "apigateway.amazonaws.com"
  source_arn    = "${aws_api_gateway_rest_api.main.execution_arn}/*/*"
}

resource "aws_lambda_permission" "api_gateway_post" {
  statement_id  = "AllowAPIGatewayInvoke"
  action        = "lambda:InvokeFunction"
  function_name = aws_lambda_function.post.function_name
  principal     = "apigateway.amazonaws.com"
  source_arn    = "${aws_api_gateway_rest_api.main.execution_arn}/*/*"
}

resource "aws_lambda_permission" "api_gateway_put" {
  statement_id  = "AllowAPIGatewayInvoke"
  action        = "lambda:InvokeFunction"
  function_name = aws_lambda_function.put.function_name
  principal     = "apigateway.amazonaws.com"
  source_arn    = "${aws_api_gateway_rest_api.main.execution_arn}/*/*"
}

resource "aws_lambda_permission" "api_gateway_delete" {
  statement_id  = "AllowAPIGatewayInvoke"
  action        = "lambda:InvokeFunction"
  function_name = aws_lambda_function.delete.function_name
  principal     = "apigateway.amazonaws.com"
  source_arn    = "${aws_api_gateway_rest_api.main.execution_arn}/*/*"
}

{% if api_key_required %}
# ============================================================================
# API Keys & Usage Plans
# ============================================================================

resource "aws_api_gateway_api_key" "main" {
  name = "${var.api_name}-key"
}

resource "aws_api_gateway_usage_plan" "main" {
  name = "${var.api_name}-usage-plan"

  api_stages {
    api_id = aws_api_gateway_rest_api.main.id
    stage  = aws_api_gateway_stage.prod.stage_name
  }

  quota_settings {
    limit  = 10000
    period = "MONTH"
  }

  throttle_settings {
    burst_limit = 100
    rate_limit  = 50
  }
}

resource "aws_api_gateway_usage_plan_key" "main" {
  key_id        = aws_api_gateway_api_key.main.id
  key_type      = "API_KEY"
  usage_plan_id = aws_api_gateway_usage_plan.main.id
}
{% endif %}

# ============================================================================
# Outputs
# ============================================================================

output "api_endpoint" {
  description = "API Gateway Endpoint"
  value       = aws_api_gateway_stage.prod.invoke_url
}

output "api_id" {
  description = "API Gateway ID"
  value       = aws_api_gateway_rest_api.main.id
}

output "dynamodb_table_name" {
  description = "DynamoDB Table Name"
  value       = aws_dynamodb_table.main.name
}

output "lambda_function_names" {
  description = "Lambda Function Names"
  value = {
    get    = aws_lambda_function.get.function_name
    post   = aws_lambda_function.post.function_name
    put    = aws_lambda_function.put.function_name
    delete = aws_lambda_function.delete.function_name
  }
}

{% if api_key_required %}
output "api_key" {
  description = "API Key (keep secret!)"
  value       = aws_api_gateway_api_key.main.value
  sensitive   = true
}
{% endif %}

output "deployment_instructions" {
  description = "Deployment Instructions"
  value       = <<-EOT
    ========================================
    Simple API Deployment Instructions
    ========================================

    1. Update Lambda Functions:
       # Beispiel Python:
       zip function.zip lambda_handler.py
       aws lambda update-function-code --function-name ${aws_lambda_function.get.function_name} --zip-file fileb://function.zip
       aws lambda update-function-code --function-name ${aws_lambda_function.post.function_name} --zip-file fileb://function.zip
       aws lambda update-function-code --function-name ${aws_lambda_function.put.function_name} --zip-file fileb://function.zip
       aws lambda update-function-code --function-name ${aws_lambda_function.delete.function_name} --zip-file fileb://function.zip

    2. Test API:
       # GET all items
       curl ${aws_api_gateway_stage.prod.invoke_url}/items{% if api_key_required %} -H "x-api-key: YOUR_API_KEY"{% endif %}

       # POST new item
       curl -X POST ${aws_api_gateway_stage.prod.invoke_url}/items \
         -H "Content-Type: application/json"{% if api_key_required %} \
         -H "x-api-key: YOUR_API_KEY"{% endif %} \
         -d '{"name": "test", "value": 123}'

       # GET by ID
       curl ${aws_api_gateway_stage.prod.invoke_url}/items/abc123{% if api_key_required %} -H "x-api-key: YOUR_API_KEY"{% endif %}

       # PUT (update)
       curl -X PUT ${aws_api_gateway_stage.prod.invoke_url}/items/abc123 \
         -H "Content-Type: application/json"{% if api_key_required %} \
         -H "x-api-key: YOUR_API_KEY"{% endif %} \
         -d '{"name": "updated"}'

       # DELETE
       curl -X DELETE ${aws_api_gateway_stage.prod.invoke_url}/items/abc123{% if api_key_required %} -H "x-api-key: YOUR_API_KEY"{% endif %}

    3. CloudWatch Logs:
       aws logs tail /aws/lambda/${aws_lambda_function.get.function_name} --follow

    ========================================
  EOT
}
