# Three-Tier Web Application - VPC
# Blueprint: {{ blueprint_id }}
# Generated by OverCloud

# VPC
resource "aws_vpc" "main" {
  cidr_block           = "{{ vpc_cidr }}"
  enable_dns_hostnames = true
  enable_dns_support   = true

  tags = {
    Name        = "{{ app_name }}-vpc"
    Blueprint   = "{{ blueprint_id }}"
    Environment = var.environment
    ManagedBy   = "OverCloud"
  }
}

# Internet Gateway
resource "aws_internet_gateway" "main" {
  vpc_id = aws_vpc.main.id

  tags = {
    Name        = "{{ app_name }}-igw"
    Blueprint   = "{{ blueprint_id }}"
    Environment = var.environment
    ManagedBy   = "OverCloud"
  }
}

# Public Subnets (für ALB)
resource "aws_subnet" "public_a" {
  vpc_id                  = aws_vpc.main.id
  cidr_block              = cidrsubnet(var.vpc_cidr, 8, 0)  # z.B. 10.0.0.0/24
  availability_zone       = data.aws_availability_zones.available.names[0]
  map_public_ip_on_launch = true

  tags = {
    Name        = "{{ app_name }}-public-a"
    Type        = "Public"
    Blueprint   = "{{ blueprint_id }}"
    Environment = var.environment
    ManagedBy   = "OverCloud"
  }
}

resource "aws_subnet" "public_b" {
  vpc_id                  = aws_vpc.main.id
  cidr_block              = cidrsubnet(var.vpc_cidr, 8, 1)  # z.B. 10.0.1.0/24
  availability_zone       = data.aws_availability_zones.available.names[1]
  map_public_ip_on_launch = true

  tags = {
    Name        = "{{ app_name }}-public-b"
    Type        = "Public"
    Blueprint   = "{{ blueprint_id }}"
    Environment = var.environment
    ManagedBy   = "OverCloud"
  }
}

# Private Subnets (für EC2 & RDS)
resource "aws_subnet" "private_a" {
  vpc_id            = aws_vpc.main.id
  cidr_block        = cidrsubnet(var.vpc_cidr, 8, 10)  # z.B. 10.0.10.0/24
  availability_zone = data.aws_availability_zones.available.names[0]

  tags = {
    Name        = "{{ app_name }}-private-a"
    Type        = "Private"
    Blueprint   = "{{ blueprint_id }}"
    Environment = var.environment
    ManagedBy   = "OverCloud"
  }
}

resource "aws_subnet" "private_b" {
  vpc_id            = aws_vpc.main.id
  cidr_block        = cidrsubnet(var.vpc_cidr, 8, 11)  # z.B. 10.0.11.0/24
  availability_zone = data.aws_availability_zones.available.names[1]

  tags = {
    Name        = "{{ app_name }}-private-b"
    Type        = "Private"
    Blueprint   = "{{ blueprint_id }}"
    Environment = var.environment
    ManagedBy   = "OverCloud"
  }
}

# Database Subnets (für RDS)
resource "aws_subnet" "database_a" {
  vpc_id            = aws_vpc.main.id
  cidr_block        = cidrsubnet(var.vpc_cidr, 8, 20)  # z.B. 10.0.20.0/24
  availability_zone = data.aws_availability_zones.available.names[0]

  tags = {
    Name        = "{{ app_name }}-database-a"
    Type        = "Database"
    Blueprint   = "{{ blueprint_id }}"
    Environment = var.environment
    ManagedBy   = "OverCloud"
  }
}

resource "aws_subnet" "database_b" {
  vpc_id            = aws_vpc.main.id
  cidr_block        = cidrsubnet(var.vpc_cidr, 8, 21)  # z.B. 10.0.21.0/24
  availability_zone = data.aws_availability_zones.available.names[1]

  tags = {
    Name        = "{{ app_name }}-database-b"
    Type        = "Database"
    Blueprint   = "{{ blueprint_id }}"
    Environment = var.environment
    ManagedBy   = "OverCloud"
  }
}

# NAT Gateway (für Private Subnets outbound Internet)
resource "aws_eip" "nat" {
  domain = "vpc"

  tags = {
    Name        = "{{ app_name }}-nat-eip"
    Blueprint   = "{{ blueprint_id }}"
    Environment = var.environment
    ManagedBy   = "OverCloud"
  }
}

resource "aws_nat_gateway" "main" {
  allocation_id = aws_eip.nat.id
  subnet_id     = aws_subnet.public_a.id

  tags = {
    Name        = "{{ app_name }}-nat"
    Blueprint   = "{{ blueprint_id }}"
    Environment = var.environment
    ManagedBy   = "OverCloud"
  }

  depends_on = [aws_internet_gateway.main]
}

# Route Table für Public Subnets
resource "aws_route_table" "public" {
  vpc_id = aws_vpc.main.id

  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.main.id
  }

  tags = {
    Name        = "{{ app_name }}-public-rt"
    Blueprint   = "{{ blueprint_id }}"
    Environment = var.environment
    ManagedBy   = "OverCloud"
  }
}

resource "aws_route_table_association" "public_a" {
  subnet_id      = aws_subnet.public_a.id
  route_table_id = aws_route_table.public.id
}

resource "aws_route_table_association" "public_b" {
  subnet_id      = aws_subnet.public_b.id
  route_table_id = aws_route_table.public.id
}

# Route Table für Private Subnets
resource "aws_route_table" "private" {
  vpc_id = aws_vpc.main.id

  route {
    cidr_block     = "0.0.0.0/0"
    nat_gateway_id = aws_nat_gateway.main.id
  }

  tags = {
    Name        = "{{ app_name }}-private-rt"
    Blueprint   = "{{ blueprint_id }}"
    Environment = var.environment
    ManagedBy   = "OverCloud"
  }
}

resource "aws_route_table_association" "private_a" {
  subnet_id      = aws_subnet.private_a.id
  route_table_id = aws_route_table.private.id
}

resource "aws_route_table_association" "private_b" {
  subnet_id      = aws_subnet.private_b.id
  route_table_id = aws_route_table.private.id
}

# Route Table für Database Subnets (kein Internet)
resource "aws_route_table" "database" {
  vpc_id = aws_vpc.main.id

  tags = {
    Name        = "{{ app_name }}-database-rt"
    Blueprint   = "{{ blueprint_id }}"
    Environment = var.environment
    ManagedBy   = "OverCloud"
  }
}

resource "aws_route_table_association" "database_a" {
  subnet_id      = aws_subnet.database_a.id
  route_table_id = aws_route_table.database.id
}

resource "aws_route_table_association" "database_b" {
  subnet_id      = aws_subnet.database_b.id
  route_table_id = aws_route_table.database.id
}

# DB Subnet Group für RDS
resource "aws_db_subnet_group" "main" {
  name       = "{{ app_name }}-db-subnet-group"
  subnet_ids = [aws_subnet.database_a.id, aws_subnet.database_b.id]

  tags = {
    Name        = "{{ app_name }}-db-subnet-group"
    Blueprint   = "{{ blueprint_id }}"
    Environment = var.environment
    ManagedBy   = "OverCloud"
  }
}

# Data Source für Availability Zones
data "aws_availability_zones" "available" {
  state = "available"
}
