# Static Website - S3 Bucket
# Blueprint: {{ blueprint_id }}
# Generated by OverCloud

# S3 Bucket für Static Website Hosting
resource "aws_s3_bucket" "website" {
  bucket = "{{ website_name }}-website-${random_id.bucket_suffix.hex}"

  tags = {
    Name        = "{{ website_name }}-website"
    Blueprint   = "{{ blueprint_id }}"
    Environment = var.environment
    ManagedBy   = "OverCloud"
  }
}

# Random ID für eindeutige Bucket Namen
resource "random_id" "bucket_suffix" {
  byte_length = 4
}

# Website Configuration
resource "aws_s3_bucket_website_configuration" "website" {
  bucket = aws_s3_bucket.website.id

  index_document {
    suffix = "{{ index_document }}"
  }

  {% if error_document %}
  error_document {
    key = "{{ error_document }}"
  }
  {% endif %}
}

# Public Access Block (erstmal alles blockieren, CloudFront greift via OAI zu)
resource "aws_s3_bucket_public_access_block" "website" {
  bucket = aws_s3_bucket.website.id

  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

# Bucket Policy für CloudFront OAI
resource "aws_s3_bucket_policy" "website" {
  bucket = aws_s3_bucket.website.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid    = "AllowCloudFrontOAI"
        Effect = "Allow"
        Principal = {
          AWS = aws_cloudfront_origin_access_identity.website.iam_arn
        }
        Action   = "s3:GetObject"
        Resource = "${aws_s3_bucket.website.arn}/*"
      }
    ]
  })
}

{% if enable_versioning %}
# Bucket Versioning
resource "aws_s3_bucket_versioning" "website" {
  bucket = aws_s3_bucket.website.id

  versioning_configuration {
    status = "Enabled"
  }
}
{% endif %}

# Server-Side Encryption (immer aktiviert)
resource "aws_s3_bucket_server_side_encryption_configuration" "website" {
  bucket = aws_s3_bucket.website.id

  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm = "AES256"
    }
  }
}

# Lifecycle Rules für alte Versionen (falls Versioning aktiviert)
{% if enable_versioning %}
resource "aws_s3_bucket_lifecycle_configuration" "website" {
  bucket = aws_s3_bucket.website.id

  rule {
    id     = "delete-old-versions"
    status = "Enabled"

    noncurrent_version_expiration {
      noncurrent_days = 90
    }
  }
}
{% endif %}
