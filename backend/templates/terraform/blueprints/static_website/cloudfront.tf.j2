# Static Website - CloudFront Distribution
# Blueprint: {{ blueprint_id }}
# Generated by OverCloud

# CloudFront Origin Access Identity
resource "aws_cloudfront_origin_access_identity" "website" {
  comment = "OAI for {{ website_name }}"
}

# CloudFront Distribution
resource "aws_cloudfront_distribution" "website" {
  enabled             = true
  is_ipv6_enabled     = true
  default_root_object = "{{ index_document }}"
  price_class         = "{{ cloudfront_price_class }}"
  {% if domain_name %}
  aliases             = ["{{ domain_name }}"]
  {% endif %}
  comment             = "{{ website_name }} - Static Website"

  # S3 Origin
  origin {
    domain_name = aws_s3_bucket.website.bucket_regional_domain_name
    origin_id   = "S3-{{ website_name }}"

    s3_origin_config {
      origin_access_identity = aws_cloudfront_origin_access_identity.website.cloudfront_access_identity_path
    }
  }

  # Default Cache Behavior
  default_cache_behavior {
    target_origin_id       = "S3-{{ website_name }}"
    viewer_protocol_policy = "redirect-to-https"
    allowed_methods        = ["GET", "HEAD", "OPTIONS"]
    cached_methods         = ["GET", "HEAD"]
    compress               = {{ enable_compression | default(true) | lower }}

    forwarded_values {
      query_string = false
      cookies {
        forward = "none"
      }
    }

    min_ttl     = 0
    default_ttl = 3600   # 1 Stunde
    max_ttl     = 86400  # 24 Stunden
  }

  # Custom Error Responses für SPA Routing
  {% if error_document %}
  custom_error_response {
    error_code         = 404
    response_code      = 200
    response_page_path = "/{{ error_document }}"
  }

  custom_error_response {
    error_code         = 403
    response_code      = 200
    response_page_path = "/{{ error_document }}"
  }
  {% endif %}

  # Geo Restrictions (keine)
  restrictions {
    geo_restriction {
      restriction_type = "none"
    }
  }

  # SSL Certificate
  viewer_certificate {
    {% if domain_name %}
    acm_certificate_arn      = aws_acm_certificate.website.arn
    ssl_support_method       = "sni-only"
    minimum_protocol_version = "TLSv1.2_2021"
    {% else %}
    cloudfront_default_certificate = true
    {% endif %}
  }

  tags = {
    Name        = "{{ website_name }}-cloudfront"
    Blueprint   = "{{ blueprint_id }}"
    Environment = var.environment
    ManagedBy   = "OverCloud"
  }
}

# CloudFront Function für SPA Routing (optional)
resource "aws_cloudfront_function" "spa_routing" {
  name    = "{{ website_name }}-spa-routing"
  runtime = "cloudfront-js-1.0"
  comment = "SPA routing support"
  publish = true

  code = <<-EOT
function handler(event) {
  var request = event.request;
  var uri = request.uri;

  // SPA Routing: Alle Nicht-Datei-Requests zu index.html
  if (!uri.includes('.')) {
    request.uri = '/{{ index_document }}';
  }

  return request;
}
EOT
}
