# Simple API - Lambda Function
# Blueprint: {{ blueprint_id }}
# Generated by OverCloud

# Lambda Execution Role
resource "aws_iam_role" "lambda" {
  name = "{{ api_name }}-lambda-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect = "Allow"
        Principal = {
          Service = "lambda.amazonaws.com"
        }
        Action = "sts:AssumeRole"
      }
    ]
  })

  tags = {
    Name        = "{{ api_name }}-lambda-role"
    Blueprint   = "{{ blueprint_id }}"
    Environment = var.environment
    ManagedBy   = "OverCloud"
  }
}

# Lambda Basic Execution Policy
resource "aws_iam_role_policy_attachment" "lambda_basic" {
  role       = aws_iam_role.lambda.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
}

# DynamoDB Access Policy
resource "aws_iam_role_policy" "lambda_dynamodb" {
  name = "{{ api_name }}-dynamodb-access"
  role = aws_iam_role.lambda.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect = "Allow"
        Action = [
          "dynamodb:GetItem",
          "dynamodb:PutItem",
          "dynamodb:UpdateItem",
          "dynamodb:DeleteItem",
          "dynamodb:Query",
          "dynamodb:Scan"
        ]
        Resource = aws_dynamodb_table.api.arn
      }
    ]
  })
}

# Lambda Function
resource "aws_lambda_function" "api" {
  function_name = "{{ api_name }}-handler"
  role          = aws_iam_role.lambda.arn
  runtime       = "{{ lambda_runtime }}"
  handler       = "index.handler"
  memory_size   = {{ lambda_memory_mb }}
  timeout       = {{ lambda_timeout_seconds }}

  # Placeholder Code (User muss später echten Code deployen)
  filename         = data.archive_file.lambda_placeholder.output_path
  source_code_hash = data.archive_file.lambda_placeholder.output_base64sha256

  environment {
    variables = {
      DYNAMODB_TABLE = aws_dynamodb_table.api.name
      {% if enable_cors %}
      CORS_ORIGIN    = "*"  # In Production: spezifische Domain
      {% endif %}
    }
  }

  {% if enable_cloudwatch_logs %}
  logging_config {
    log_format = "JSON"
    log_group  = aws_cloudwatch_log_group.lambda.name
  }
  {% endif %}

  tags = {
    Name        = "{{ api_name }}-lambda"
    Blueprint   = "{{ blueprint_id }}"
    Environment = var.environment
    ManagedBy   = "OverCloud"
  }
}

# Placeholder Lambda Code (Hello World)
data "archive_file" "lambda_placeholder" {
  type        = "zip"
  output_path = "${path.module}/lambda_placeholder.zip"

  source {
    content  = <<-EOT
{% if lambda_runtime.startswith('python') %}
import json
import os

def handler(event, context):
    return {
        'statusCode': 200,
        'headers': {
            'Content-Type': 'application/json',
            {% if enable_cors %}
            'Access-Control-Allow-Origin': '*',
            'Access-Control-Allow-Methods': 'GET,POST,PUT,DELETE',
            'Access-Control-Allow-Headers': 'Content-Type',
            {% endif %}
        },
        'body': json.dumps({
            'message': 'Hello from {{ api_name }}!',
            'table': os.environ.get('DYNAMODB_TABLE')
        })
    }
{% else %}
export const handler = async (event) => {
    return {
        statusCode: 200,
        headers: {
            'Content-Type': 'application/json',
            {% if enable_cors %}
            'Access-Control-Allow-Origin': '*',
            'Access-Control-Allow-Methods': 'GET,POST,PUT,DELETE',
            'Access-Control-Allow-Headers': 'Content-Type',
            {% endif %}
        },
        body: JSON.stringify({
            message: 'Hello from {{ api_name }}!',
            table: process.env.DYNAMODB_TABLE
        })
    };
};
{% endif %}
EOT
    filename = "index.{{ 'py' if lambda_runtime.startswith('python') else 'js' }}"
  }
}

{% if enable_cloudwatch_logs %}
# CloudWatch Log Group
resource "aws_cloudwatch_log_group" "lambda" {
  name              = "/aws/lambda/{{ api_name }}-handler"
  retention_in_days = 7

  tags = {
    Name        = "{{ api_name }}-logs"
    Blueprint   = "{{ blueprint_id }}"
    Environment = var.environment
    ManagedBy   = "OverCloud"
  }
}
{% endif %}

# Lambda Permission für API Gateway
resource "aws_lambda_permission" "api_gateway" {
  statement_id  = "AllowAPIGatewayInvoke"
  action        = "lambda:InvokeFunction"
  function_name = aws_lambda_function.api.function_name
  principal     = "apigateway.amazonaws.com"
  source_arn    = "${aws_api_gateway_rest_api.api.execution_arn}/*/*"
}
