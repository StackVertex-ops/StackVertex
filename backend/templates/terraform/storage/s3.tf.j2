# S3 Bucket: {{ name }}
# Generated by OverCloud

resource "aws_s3_bucket" "{{ id | tf_identifier }}" {
  bucket = "{{ config.bucket_name | default(name | tf_identifier) }}"

  tags = {
    Name        = "{{ name }}"
    Environment = var.environment
    ManagedBy   = "OverCloud"
  }
}

{% if config.versioning_enabled %}
# Bucket Versioning
resource "aws_s3_bucket_versioning" "{{ id | tf_identifier }}" {
  bucket = aws_s3_bucket.{{ id | tf_identifier }}.id

  versioning_configuration {
    status = "Enabled"
  }
}
{% endif %}

{% if config.encryption_enabled %}
# Bucket Encryption
resource "aws_s3_bucket_server_side_encryption_configuration" "{{ id | tf_identifier }}" {
  bucket = aws_s3_bucket.{{ id | tf_identifier }}.id

  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm = "{{ config.encryption_algorithm | default('AES256') }}"
    }
  }
}
{% endif %}

{% if config.public_access_block %}
# Block Public Access
resource "aws_s3_bucket_public_access_block" "{{ id | tf_identifier }}" {
  bucket = aws_s3_bucket.{{ id | tf_identifier }}.id

  block_public_acls       = {{ config.public_access_block.block_public_acls | default(true) | tf_bool }}
  block_public_policy     = {{ config.public_access_block.block_public_policy | default(true) | tf_bool }}
  ignore_public_acls      = {{ config.public_access_block.ignore_public_acls | default(true) | tf_bool }}
  restrict_public_buckets = {{ config.public_access_block.restrict_public_buckets | default(true) | tf_bool }}
}
{% endif %}

{% if config.lifecycle_rules %}
# Lifecycle Rules
resource "aws_s3_bucket_lifecycle_configuration" "{{ id | tf_identifier }}" {
  bucket = aws_s3_bucket.{{ id | tf_identifier }}.id

  {% for rule in config.lifecycle_rules %}
  rule {
    id     = "{{ rule.id }}"
    status = "{{ rule.status | default('Enabled') }}"

    {% if rule.expiration_days %}
    expiration {
      days = {{ rule.expiration_days }}
    }
    {% endif %}

    {% if rule.transition %}
    transition {
      days          = {{ rule.transition.days }}
      storage_class = "{{ rule.transition.storage_class }}"
    }
    {% endif %}
  }
  {% endfor %}
}
{% endif %}
