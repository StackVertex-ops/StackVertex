# EC2 Instance: {{ name }}
# Generated by OverCloud

resource "aws_instance" "{{ id | tf_identifier }}" {
  ami           = "{{ config.ami | default('ami-0c55b159cbfafe1f0') }}"
  instance_type = "{{ config.instance_type | default('t3.micro') }}"

  {% if config.subnet_id %}
  subnet_id = {{ config.subnet_id }}
  {% endif %}

  {% if config.vpc_security_group_ids %}
  vpc_security_group_ids = {{ config.vpc_security_group_ids | tf_list }}
  {% endif %}

  {% if config.key_name %}
  key_name = "{{ config.key_name }}"
  {% endif %}

  {% if config.user_data %}
  user_data = <<-EOF
{{ config.user_data | indent(4, first=True) }}
  EOF
  {% endif %}

  {% if config.ebs_optimized %}
  ebs_optimized = {{ config.ebs_optimized | tf_bool }}
  {% endif %}

  {% if config.monitoring %}
  monitoring = {{ config.monitoring | tf_bool }}
  {% endif %}

  tags = {
    Name        = "{{ name }}"
    Environment = var.environment
    ManagedBy   = "OverCloud"
  }
}
