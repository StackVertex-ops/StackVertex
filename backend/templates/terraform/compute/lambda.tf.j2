# Lambda Function: {{ name }}
# Generated by OverCloud

resource "aws_lambda_function" "{{ id | tf_identifier }}" {
  function_name = "{{ config.function_name | default(name | tf_identifier) }}"
  role          = {{ config.role_arn | default('aws_iam_role.' ~ id ~ '_role.arn') }}

  {% if config.filename %}
  filename         = "{{ config.filename }}"
  source_code_hash = filebase64sha256("{{ config.filename }}")
  {% elif config.s3_bucket %}
  s3_bucket = "{{ config.s3_bucket }}"
  s3_key    = "{{ config.s3_key }}"
  {% if config.s3_object_version %}
  s3_object_version = "{{ config.s3_object_version }}"
  {% endif %}
  {% endif %}

  handler = "{{ config.handler | default('index.handler') }}"
  runtime = "{{ config.runtime | default('python3.11') }}"

  {% if config.timeout %}
  timeout = {{ config.timeout }}
  {% endif %}

  {% if config.memory_size %}
  memory_size = {{ config.memory_size }}
  {% endif %}

  {% if config.environment_variables %}
  environment {
    variables = {{ config.environment_variables | tf_map }}
  }
  {% endif %}

  {% if config.vpc_config %}
  vpc_config {
    subnet_ids         = {{ config.vpc_config.subnet_ids | tf_list }}
    security_group_ids = {{ config.vpc_config.security_group_ids | tf_list }}
  }
  {% endif %}

  tags = {
    Name        = "{{ name }}"
    Environment = var.environment
    ManagedBy   = "OverCloud"
  }
}

{% if not config.role_arn %}
# IAM Role for Lambda
resource "aws_iam_role" "{{ id | tf_identifier }}_role" {
  name = "{{ name | tf_identifier }}_lambda_role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Action = "sts:AssumeRole"
        Effect = "Allow"
        Principal = {
          Service = "lambda.amazonaws.com"
        }
      }
    ]
  })

  tags = {
    Name        = "{{ name }} Lambda Role"
    Environment = var.environment
    ManagedBy   = "OverCloud"
  }
}

# Attach basic Lambda execution policy
resource "aws_iam_role_policy_attachment" "{{ id | tf_identifier }}_policy" {
  role       = aws_iam_role.{{ id | tf_identifier }}_role.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
}
{% endif %}
