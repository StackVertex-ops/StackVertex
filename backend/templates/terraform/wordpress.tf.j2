# ============================================================================
# WordPress Website - EC2 + RDS MySQL + EFS + CloudFront
# ============================================================================
# Generated by OverCloud
# Blueprint: {{ blueprint_id }}
# Created: {{ created_at }}

terraform {
  required_version = ">= 1.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }

  backend "s3" {
    bucket         = "{{ state_bucket_name }}"
    key            = "{{ project_name }}/terraform.tfstate"
    region         = "{{ aws_region }}"
    encrypt        = true
    dynamodb_table = "terraform-locks"
  }
}

provider "aws" {
  region = var.aws_region

  default_tags {
    tags = {
      Project     = "{{ project_name }}"
      Environment = var.environment
      ManagedBy   = "OverCloud"
      Blueprint   = "wordpress"
      CreatedAt   = "{{ created_at }}"
    }
  }
}

# ============================================================================
# Variables
# ============================================================================

variable "aws_region" {
  description = "AWS Region"
  type        = string
  default     = "us-east-1"
}

variable "environment" {
  description = "Environment (dev, staging, prod)"
  type        = string
  default     = "prod"
}

variable "site_name" {
  description = "WordPress Site Name"
  type        = string
  default     = "{{ site_name }}"
}

variable "domain_name" {
  description = "Domain Name"
  type        = string
  default     = "{{ domain_name }}"
}

variable "admin_email" {
  description = "WordPress Admin Email"
  type        = string
  default     = "{{ admin_email }}"
}

variable "ec2_instance_type" {
  description = "EC2 Instance Type"
  type        = string
  default     = "{{ ec2_instance_type }}"
}

variable "rds_instance_class" {
  description = "RDS Instance Class"
  type        = string
  default     = "{{ rds_instance_class }}"
}

variable "rds_storage_gb" {
  description = "RDS Storage (GB)"
  type        = number
  default     = {{ rds_storage_gb }}
}

variable "enable_cloudfront" {
  description = "Enable CloudFront CDN"
  type        = bool
  default     = {{ enable_cloudfront | default(true) | lower }}
}

variable "enable_auto_backups" {
  description = "Enable automatic backups"
  type        = bool
  default     = {{ enable_auto_backups | default(true) | lower }}
}

variable "php_version" {
  description = "PHP Version"
  type        = string
  default     = "{{ php_version }}"
}

{% if wordpress_plugins %}
variable "wordpress_plugins" {
  description = "WordPress Plugins to install"
  type        = list(string)
  default     = {{ wordpress_plugins | tojson }}
}
{% endif %}

# ============================================================================
# Data Sources
# ============================================================================

data "aws_availability_zones" "available" {
  state = "available"
}

# Latest Amazon Linux 2023 AMI
data "aws_ami" "amazon_linux" {
  most_recent = true
  owners      = ["amazon"]

  filter {
    name   = "name"
    values = ["al2023-ami-*-x86_64"]
  }

  filter {
    name   = "virtualization-type"
    values = ["hvm"]
  }
}

# ============================================================================
# VPC & Networking (Simple Setup)
# ============================================================================

resource "aws_vpc" "main" {
  cidr_block           = "10.0.0.0/16"
  enable_dns_hostnames = true
  enable_dns_support   = true

  tags = {
    Name = "${var.site_name}-vpc"
  }
}

resource "aws_internet_gateway" "main" {
  vpc_id = aws_vpc.main.id

  tags = {
    Name = "${var.site_name}-igw"
  }
}

# Public Subnet
resource "aws_subnet" "public" {
  vpc_id                  = aws_vpc.main.id
  cidr_block              = "10.0.1.0/24"
  availability_zone       = data.aws_availability_zones.available.names[0]
  map_public_ip_on_launch = true

  tags = {
    Name = "${var.site_name}-public-subnet"
  }
}

# Private Subnets für RDS (Multi-AZ)
resource "aws_subnet" "private" {
  count             = 2
  vpc_id            = aws_vpc.main.id
  cidr_block        = "10.0.${count.index + 10}.0/24"
  availability_zone = data.aws_availability_zones.available.names[count.index]

  tags = {
    Name = "${var.site_name}-private-subnet-${count.index + 1}"
  }
}

# Route Table für Public Subnet
resource "aws_route_table" "public" {
  vpc_id = aws_vpc.main.id

  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.main.id
  }

  tags = {
    Name = "${var.site_name}-public-rt"
  }
}

resource "aws_route_table_association" "public" {
  subnet_id      = aws_subnet.public.id
  route_table_id = aws_route_table.public.id
}

# ============================================================================
# Security Groups
# ============================================================================

# EC2 Security Group
resource "aws_security_group" "ec2" {
  name        = "${var.site_name}-ec2-sg"
  description = "Security Group for WordPress EC2"
  vpc_id      = aws_vpc.main.id

  ingress {
    description = "HTTP from Internet"
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    description = "HTTPS from Internet"
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    description = "SSH from Internet"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    description = "All outbound traffic"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "${var.site_name}-ec2-sg"
  }
}

# RDS Security Group
resource "aws_security_group" "rds" {
  name        = "${var.site_name}-rds-sg"
  description = "Security Group for RDS MySQL"
  vpc_id      = aws_vpc.main.id

  ingress {
    description     = "MySQL from EC2"
    from_port       = 3306
    to_port         = 3306
    protocol        = "tcp"
    security_groups = [aws_security_group.ec2.id]
  }

  egress {
    description = "All outbound traffic"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "${var.site_name}-rds-sg"
  }
}

# EFS Security Group
resource "aws_security_group" "efs" {
  name        = "${var.site_name}-efs-sg"
  description = "Security Group for EFS"
  vpc_id      = aws_vpc.main.id

  ingress {
    description     = "NFS from EC2"
    from_port       = 2049
    to_port         = 2049
    protocol        = "tcp"
    security_groups = [aws_security_group.ec2.id]
  }

  egress {
    description = "All outbound traffic"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "${var.site_name}-efs-sg"
  }
}

# ============================================================================
# EFS für WordPress Media Files
# ============================================================================

resource "aws_efs_file_system" "wordpress" {
  creation_token = "${var.site_name}-efs"
  encrypted      = true

  lifecycle_policy {
    transition_to_ia = "AFTER_30_DAYS"
  }

  tags = {
    Name = "${var.site_name}-efs"
  }
}

resource "aws_efs_mount_target" "wordpress" {
  file_system_id  = aws_efs_file_system.wordpress.id
  subnet_id       = aws_subnet.public.id
  security_groups = [aws_security_group.efs.id]
}

# ============================================================================
# RDS MySQL Database
# ============================================================================

resource "aws_db_subnet_group" "main" {
  name       = "${var.site_name}-db-subnet-group"
  subnet_ids = aws_subnet.private[*].id

  tags = {
    Name = "${var.site_name}-db-subnet-group"
  }
}

resource "aws_db_instance" "wordpress" {
  identifier     = "${var.site_name}-db"
  engine         = "mysql"
  engine_version = "8.0"
  instance_class = var.rds_instance_class

  allocated_storage = var.rds_storage_gb
  storage_type      = "gp3"
  storage_encrypted = true

  db_name  = "wordpress"
  username = "wpadmin"
  password = random_password.db_password.result

  multi_az               = false
  db_subnet_group_name   = aws_db_subnet_group.main.name
  vpc_security_group_ids = [aws_security_group.rds.id]

  backup_retention_period = var.enable_auto_backups ? 7 : 0
  backup_window           = "03:00-04:00"
  maintenance_window      = "sun:04:00-sun:05:00"

  enabled_cloudwatch_logs_exports = ["error", "general", "slowquery"]

  skip_final_snapshot       = false
  final_snapshot_identifier = "${var.site_name}-db-final-${formatdate("YYYY-MM-DD-hhmm", timestamp())}"

  deletion_protection = true

  tags = {
    Name = "${var.site_name}-mysql"
  }
}

resource "random_password" "db_password" {
  length  = 32
  special = false
}

resource "random_password" "wp_admin_password" {
  length  = 20
  special = true
}

# Store credentials in Secrets Manager
resource "aws_secretsmanager_secret" "wordpress" {
  name = "${var.site_name}-credentials"
}

resource "aws_secretsmanager_secret_version" "wordpress" {
  secret_id = aws_secretsmanager_secret.wordpress.id
  secret_string = jsonencode({
    db_host          = aws_db_instance.wordpress.endpoint
    db_name          = aws_db_instance.wordpress.db_name
    db_username      = aws_db_instance.wordpress.username
    db_password      = random_password.db_password.result
    wp_admin_user    = "admin"
    wp_admin_password = random_password.wp_admin_password.result
    wp_admin_email   = var.admin_email
  })
}

# ============================================================================
# IAM Role für EC2
# ============================================================================

resource "aws_iam_role" "ec2" {
  name = "${var.site_name}-ec2-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Action = "sts:AssumeRole"
        Effect = "Allow"
        Principal = {
          Service = "ec2.amazonaws.com"
        }
      }
    ]
  })
}

resource "aws_iam_role_policy_attachment" "ec2_ssm" {
  policy_arn = "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
  role       = aws_iam_role.ec2.name
}

resource "aws_iam_role_policy_attachment" "ec2_cloudwatch" {
  policy_arn = "arn:aws:iam::aws:policy/CloudWatchAgentServerPolicy"
  role       = aws_iam_role.ec2.name
}

# Policy für Secrets Manager Access
resource "aws_iam_role_policy" "secrets_access" {
  name = "${var.site_name}-secrets-access"
  role = aws_iam_role.ec2.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect = "Allow"
        Action = [
          "secretsmanager:GetSecretValue"
        ]
        Resource = aws_secretsmanager_secret.wordpress.arn
      }
    ]
  })
}

resource "aws_iam_instance_profile" "ec2" {
  name = "${var.site_name}-ec2-profile"
  role = aws_iam_role.ec2.name
}

# ============================================================================
# Elastic IP
# ============================================================================

resource "aws_eip" "wordpress" {
  domain = "vpc"

  tags = {
    Name = "${var.site_name}-eip"
  }
}

resource "aws_eip_association" "wordpress" {
  instance_id   = aws_instance.wordpress.id
  allocation_id = aws_eip.wordpress.id
}

# ============================================================================
# EC2 Instance für WordPress
# ============================================================================

resource "aws_instance" "wordpress" {
  ami                    = data.aws_ami.amazon_linux.id
  instance_type          = var.ec2_instance_type
  subnet_id              = aws_subnet.public.id
  vpc_security_group_ids = [aws_security_group.ec2.id]
  iam_instance_profile   = aws_iam_instance_profile.ec2.name

  user_data = base64encode(templatefile("${path.module}/wordpress_userdata.sh", {
    site_name       = var.site_name
    domain_name     = var.domain_name
    admin_email     = var.admin_email
    php_version     = var.php_version
    db_host         = aws_db_instance.wordpress.endpoint
    db_name         = aws_db_instance.wordpress.db_name
    db_user         = aws_db_instance.wordpress.username
    db_password     = random_password.db_password.result
    wp_admin_user   = "admin"
    wp_admin_pass   = random_password.wp_admin_password.result
    efs_id          = aws_efs_file_system.wordpress.id
    aws_region      = var.aws_region
    secret_arn      = aws_secretsmanager_secret.wordpress.arn
{% if wordpress_plugins %}
    plugins         = join(" ", var.wordpress_plugins)
{% else %}
    plugins         = ""
{% endif %}
  }))

  root_block_device {
    volume_type           = "gp3"
    volume_size           = 20
    delete_on_termination = true
    encrypted             = true
  }

  metadata_options {
    http_tokens                 = "required"
    http_put_response_hop_limit = 1
    instance_metadata_tags      = "enabled"
  }

  tags = {
    Name = "${var.site_name}-wordpress"
  }

  depends_on = [
    aws_db_instance.wordpress,
    aws_efs_mount_target.wordpress
  ]
}

# ============================================================================
# Route53 DNS
# ============================================================================

data "aws_route53_zone" "main" {
  name         = join(".", slice(split(".", var.domain_name), 1, length(split(".", var.domain_name))))
  private_zone = false
}

resource "aws_route53_record" "wordpress" {
  zone_id = data.aws_route53_zone.main.zone_id
  name    = var.domain_name
  type    = "A"
  ttl     = 300
  records = [aws_eip.wordpress.public_ip]
}

# ============================================================================
# ACM Certificate für HTTPS
# ============================================================================

resource "aws_acm_certificate" "wordpress" {
  domain_name       = var.domain_name
  validation_method = "DNS"

  lifecycle {
    create_before_destroy = true
  }

  tags = {
    Name = var.domain_name
  }
}

resource "aws_route53_record" "cert_validation" {
  for_each = {
    for dvo in aws_acm_certificate.wordpress.domain_validation_options : dvo.domain_name => {
      name   = dvo.resource_record_name
      record = dvo.resource_record_value
      type   = dvo.resource_record_type
    }
  }

  zone_id = data.aws_route53_zone.main.zone_id
  name    = each.value.name
  type    = each.value.type
  records = [each.value.record]
  ttl     = 60
}

resource "aws_acm_certificate_validation" "wordpress" {
  certificate_arn         = aws_acm_certificate.wordpress.arn
  validation_record_fqdns = [for record in aws_route53_record.cert_validation : record.fqdn]
}

{% if enable_cloudfront %}
# ============================================================================
# CloudFront Distribution (für Media CDN)
# ============================================================================

resource "aws_cloudfront_origin_access_identity" "wordpress" {
  count   = var.enable_cloudfront ? 1 : 0
  comment = "OAI for ${var.site_name} WordPress Media"
}

resource "aws_cloudfront_distribution" "wordpress" {
  count   = var.enable_cloudfront ? 1 : 0
  enabled = true
  comment = "${var.site_name} WordPress Media CDN"

  origin {
    domain_name = aws_eip.wordpress.public_ip
    origin_id   = "wordpress-origin"

    custom_origin_config {
      http_port              = 80
      https_port             = 443
      origin_protocol_policy = "http-only"
      origin_ssl_protocols   = ["TLSv1.2"]
    }
  }

  default_cache_behavior {
    allowed_methods  = ["GET", "HEAD"]
    cached_methods   = ["GET", "HEAD"]
    target_origin_id = "wordpress-origin"

    forwarded_values {
      query_string = false

      cookies {
        forward = "none"
      }
    }

    viewer_protocol_policy = "redirect-to-https"
    min_ttl                = 0
    default_ttl            = 3600
    max_ttl                = 86400
    compress               = true
  }

  price_class = "PriceClass_100"

  restrictions {
    geo_restriction {
      restriction_type = "none"
    }
  }

  viewer_certificate {
    cloudfront_default_certificate = true
  }

  tags = {
    Name = "${var.site_name}-cloudfront"
  }
}
{% endif %}

# ============================================================================
# Outputs
# ============================================================================

output "website_url" {
  description = "WordPress Website URL"
  value       = "http://${var.domain_name}"
}

output "admin_url" {
  description = "WordPress Admin URL"
  value       = "http://${var.domain_name}/wp-admin"
}

output "ec2_public_ip" {
  description = "EC2 Public IP"
  value       = aws_eip.wordpress.public_ip
}

output "rds_endpoint" {
  description = "RDS Endpoint"
  value       = aws_db_instance.wordpress.endpoint
}

output "efs_id" {
  description = "EFS File System ID"
  value       = aws_efs_file_system.wordpress.id
}

{% if enable_cloudfront %}
output "cloudfront_domain" {
  description = "CloudFront Distribution Domain"
  value       = var.enable_cloudfront ? aws_cloudfront_distribution.wordpress[0].domain_name : null
}
{% endif %}

output "credentials_secret_arn" {
  description = "Secrets Manager ARN for WordPress Credentials"
  value       = aws_secretsmanager_secret.wordpress.arn
}

output "deployment_instructions" {
  description = "Deployment Instructions"
  value       = <<-EOT
    ========================================
    WordPress Deployment Instructions
    ========================================

    1. WordPress Setup:
       Navigate to: http://${var.domain_name}/wp-admin

       Admin Credentials (stored in Secrets Manager):
       aws secretsmanager get-secret-value --secret-id ${aws_secretsmanager_secret.wordpress.arn}

    2. SSH Access:
       ssh -i key.pem ec2-user@${aws_eip.wordpress.public_ip}

    3. WP-CLI Commands:
       # List plugins
       wp plugin list --allow-root

       # Install plugin
       wp plugin install wordfence --activate --allow-root

       # Update WordPress
       wp core update --allow-root

       # Create backup
       wp db export /tmp/backup.sql --allow-root

    4. HTTPS Setup:
       - SSL Certificate is created via ACM
       - Install Let's Encrypt on EC2:
         sudo certbot --nginx -d ${var.domain_name}

    5. Media Files:
       - Stored in EFS: ${aws_efs_file_system.wordpress.id}
       - Mounted at: /var/www/html/wp-content/uploads
{% if enable_cloudfront %}
       - CDN: ${var.enable_cloudfront ? aws_cloudfront_distribution.wordpress[0].domain_name : ""}
{% endif %}

    6. Database Backup:
       aws rds create-db-snapshot \
         --db-instance-identifier ${aws_db_instance.wordpress.id} \
         --db-snapshot-identifier wordpress-backup-$(date +%Y%m%d)

    ========================================
    CRITICAL: Save these credentials!
    ========================================
    Secret ARN: ${aws_secretsmanager_secret.wordpress.arn}

    Get credentials:
    aws secretsmanager get-secret-value --secret-id ${aws_secretsmanager_secret.wordpress.arn} --query SecretString --output text | jq
    ========================================
  EOT
}
