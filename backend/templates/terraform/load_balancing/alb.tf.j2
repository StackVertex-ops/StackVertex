# Application Load Balancer: {{ name }}
# Generated by OverCloud

resource "aws_lb" "{{ id | tf_identifier }}" {
  name               = "{{ config.name | default(name | tf_identifier) }}"
  internal           = {{ config.internal | default(false) | tf_bool }}
  load_balancer_type = "application"

  {% if config.security_groups %}
  security_groups = {{ config.security_groups | tf_list }}
  {% endif %}

  {% if config.subnets %}
  subnets = {{ config.subnets | tf_list }}
  {% endif %}

  enable_deletion_protection = {{ config.enable_deletion_protection | default(false) | tf_bool }}
  enable_http2              = {{ config.enable_http2 | default(true) | tf_bool }}

  tags = {
    Name        = "{{ name }}"
    Environment = var.environment
    ManagedBy   = "OverCloud"
  }
}

{% if config.target_group %}
# Target Group
resource "aws_lb_target_group" "{{ id | tf_identifier }}" {
  name     = "{{ config.target_group.name | default(name ~ '-tg') | tf_identifier }}"
  port     = {{ config.target_group.port | default(80) }}
  protocol = "{{ config.target_group.protocol | default('HTTP') }}"
  vpc_id   = {{ config.target_group.vpc_id | default('aws_vpc.main.id') }}

  health_check {
    enabled             = true
    healthy_threshold   = {{ config.target_group.health_check.healthy_threshold | default(2) }}
    unhealthy_threshold = {{ config.target_group.health_check.unhealthy_threshold | default(2) }}
    timeout             = {{ config.target_group.health_check.timeout | default(5) }}
    interval            = {{ config.target_group.health_check.interval | default(30) }}
    path                = "{{ config.target_group.health_check.path | default('/') }}"
    matcher             = "{{ config.target_group.health_check.matcher | default('200') }}"
  }

  tags = {
    Name        = "{{ name }} Target Group"
    Environment = var.environment
    ManagedBy   = "OverCloud"
  }
}

# Listener
resource "aws_lb_listener" "{{ id | tf_identifier }}" {
  load_balancer_arn = aws_lb.{{ id | tf_identifier }}.arn
  port              = {{ config.listener.port | default(80) }}
  protocol          = "{{ config.listener.protocol | default('HTTP') }}"

  default_action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.{{ id | tf_identifier }}.arn
  }
}
{% endif %}
