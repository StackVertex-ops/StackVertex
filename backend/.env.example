# OverCloud Backend - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# =============================================================================
# CRITICAL SECURITY SETTINGS
# =============================================================================

# JWT Secret Key - REQUIRED
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_TO_RANDOM_32_CHAR_STRING

# Environment (development, staging, production)
ENV=development

# =============================================================================
# SERVER SETTINGS
# =============================================================================

DEBUG=True
HOST=127.0.0.1
PORT=8000

# =============================================================================
# CORS SETTINGS
# =============================================================================

# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Production example:
# CORS_ORIGINS=https://app.overcloud.io

# =============================================================================
# DATABASE SETTINGS
# =============================================================================

DYNAMODB_TABLE_NAME=overcloud-dev-main
S3_LARGE_ITEMS_BUCKET=overcloud-dev-large-items

# =============================================================================
# AWS SETTINGS
# =============================================================================

AWS_REGION=us-east-1

# =============================================================================
# JWT SETTINGS
# =============================================================================

ACCESS_TOKEN_EXPIRE_MINUTES=1440

# =============================================================================
# STRIPE PAYMENT SETTINGS (Optional)
# =============================================================================

# Enable Stripe integration
STRIPE_ENABLED=False

# Stripe API Keys (get from https://dashboard.stripe.com/apikeys)
# Test Mode (for development):
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
#
# Live Mode (for production):
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Stripe Webhook Secret (get from https://dashboard.stripe.com/webhooks)
# Test Mode: whsec_...
# Live Mode: whsec_...
STRIPE_WEBHOOK_SECRET=

# =============================================================================
# PRODUCTION CHECKLIST
# =============================================================================
# [ ] Generate strong SECRET_KEY
# [ ] Set ENV=production
# [ ] Set DEBUG=False
# [ ] Configure CORS_ORIGINS
# [ ] Use IAM roles (no AWS keys in env)
# [ ] Configure Stripe Live Mode keys (if using payments)
# [ ] Register Stripe webhook endpoint
