                <!-- Frage 18 -->
                <div class="quiz-question">
                    <p class="question-text"><strong>18.</strong> Was ist eine "IAM Group"?</p>
                    <div class="options">
                        <label><input type="radio" name="q18" value="a"> Eine Sammlung von EC2 Instances</label>
                        <label><input type="radio" name="q18" value="b"> Eine Sammlung von IAM Users mit gemeinsamen Permissions</label>
                        <label><input type="radio" name="q18" value="c"> Ein Netzwerk-Segment</label>
                        <label><input type="radio" name="q18" value="d"> Ein Storage Volume</label>
                    </div>
                </div>

                <!-- Frage 19 -->
                <div class="quiz-question">
                    <p class="question-text"><strong>19.</strong> Welcher Service ist GLOBAL (nicht Region-spezifisch)?</p>
                    <div class="options">
                        <label><input type="radio" name="q19" value="a"> EC2</label>
                        <label><input type="radio" name="q19" value="b"> S3 (Buckets sind regional, aber Service ist global)</label>
                        <label><input type="radio" name="q19" value="c"> IAM</label>
                        <label><input type="radio" name="q19" value="d"> RDS</label>
                    </div>
                </div>

                <!-- Frage 20 -->
                <div class="quiz-question">
                    <p class="question-text"><strong>20.</strong> Was kostet ein NAT Gateway ungefähr pro Monat (24/7 Betrieb)?</p>
                    <div class="options">
                        <label><input type="radio" name="q20" value="a"> $5/Monat</label>
                        <label><input type="radio" name="q20" value="b"> $32/Monat (+ Data Transfer)</label>
                        <label><input type="radio" name="q20" value="c"> $100/Monat</label>
                        <label><input type="radio" name="q20" value="d"> Kostenlos</label>
                    </div>
                </div>

                <!-- Frage 21 -->
                <div class="quiz-question">
                    <p class="question-text"><strong>21.</strong> Was ist der beste Weg, um temporäre Credentials für eine Lambda Function bereitzustellen?</p>
                    <div class="options">
                        <label><input type="radio" name="q21" value="a"> Access Keys in Environment Variables</label>
                        <label><input type="radio" name="q21" value="b"> IAM Role für die Lambda Function</label>
                        <label><input type="radio" name="q21" value="c"> Hardcoded im Code</label>
                        <label><input type="radio" name="q21" value="d"> Passwort in S3 speichern</label>
                    </div>
                </div>

                <!-- Frage 22 -->
                <div class="quiz-question">
                    <p class="question-text"><strong>22.</strong> Welches Tag ist ESSENTIELL für Cost Allocation und Tracking?</p>
                    <div class="options">
                        <label><input type="radio" name="q22" value="a"> Name</label>
                        <label><input type="radio" name="q22" value="b"> Environment (Dev/Staging/Prod)</label>
                        <label><input type="radio" name="q22" value="c"> Owner</label>
                        <label><input type="radio" name="q22" value="d"> Alle oben genannten (konsistente Tagging Strategy)</label>
                    </div>
                </div>

                <!-- Frage 23 -->
                <div class="quiz-question">
                    <p class="question-text"><strong>23.</strong> Wie lange ist ein geschlossener AWS Account in "Suspended" Status (reaktivierbar)?</p>
                    <div class="options">
                        <label><input type="radio" name="q23" value="a"> 7 Tage</label>
                        <label><input type="radio" name="q23" value="b"> 30 Tage</label>
                        <label><input type="radio" name="q23" value="c"> 90 Tage</label>
                        <label><input type="radio" name="q23" value="d"> Sofort gelöscht</label>
                    </div>
                </div>

                <!-- Frage 24 -->
                <div class="quiz-question">
                    <p class="question-text"><strong>24.</strong> Was ist AWS Cost Explorer?</p>
                    <div class="options">
                        <label><input type="radio" name="q24" value="a"> Ein Tool zur Visualisierung und Analyse von AWS Kosten</label>
                        <label><input type="radio" name="q24" value="b"> Ein Database Service</label>
                        <label><input type="radio" name="q24" value="c"> Ein Monitoring Tool für EC2</label>
                        <label><input type="radio" name="q24" value="d"> Ein DNS Service</label>
                    </div>
                </div>

                <!-- Frage 25 -->
                <div class="quiz-question">
                    <p class="question-text"><strong>25.</strong> Was solltest du als LETZTES tun, bevor du deinen AWS Account schließt?</p>
                    <div class="options">
                        <label><input type="radio" name="q25" value="a"> MFA deaktivieren</label>
                        <label><input type="radio" name="q25" value="b"> Alle Ressourcen löschen und ausstehende Rechnungen bezahlen</label>
                        <label><input type="radio" name="q25" value="c"> Neue EC2 Instances starten</label>
                        <label><input type="radio" name="q25" value="d"> IAM Users erstellen</label>
                    </div>
                </div>

                <!-- Quiz Controls -->
                <div style="margin: 2rem 0; display: flex; gap: 1rem; justify-content: center;">
                    <button onclick="checkQuiz()" style="background: #667eea; color: white; border: none; padding: 1rem 2rem; border-radius: 8px; font-size: 1rem; font-weight: 600; cursor: pointer; box-shadow: 0 4px 6px rgba(102, 126, 234, 0.3);">
                        📊 Auswertung anzeigen
                    </button>
                    <button onclick="resetQuiz()" style="background: #718096; color: white; border: none; padding: 1rem 2rem; border-radius: 8px; font-size: 1rem; font-weight: 600; cursor: pointer;">
                        🔄 Quiz zurücksetzen
                    </button>
                </div>

                <!-- Quiz Result Container -->
                <div id="quiz-result" style="margin-top: 30px;"></div>
            </div>
        </div>
    </div>

    <script>
        function switchTab(tabId) {
            // Hide all tabs
            const tabs = document.querySelectorAll('.tab-content');
            tabs.forEach(tab => tab.classList.remove('active'));

            // Remove active class from all buttons
            const buttons = document.querySelectorAll('.tab');
            buttons.forEach(button => button.classList.remove('active'));

            // Show selected tab
            document.getElementById(tabId).classList.add('active');

            // Add active class to clicked button
            event.target.classList.add('active');
        }

        function checkQuiz() {
            // Richtige Antworten
            const answers = {
                q1: 'b',  // MFA für Root Account aktivieren
                q2: 'b',  // 12 Monate
                q3: 'a',  // Users haben Passwörter, Roles nicht
                q4: 'a',  // CloudWatch Billing Alarm
                q5: 'b',  // Frankfurt
                q6: 'b',  // Ein oder mehrere isolierte Rechenzentren in einer Region
                q7: 'b',  // MFA aktiviert, nur für kritische Tasks
                q8: 'b',  // ~$0.005/Stunde
                q9: 'b',  // S3
                q10: 'b', // Auf GitHub committen
                q11: 'b', // Verbietet die Aktion (überschreibt alle "Allow")
                q12: 'b', // $0.00 (kostenlos)
                q13: 'b', // Audit Logging Service
                q14: 'c', // Lambda
                q15: 'c', // Access Keys
                q16: 'b', // Multi-Account Management mit Consolidated Billing
                q17: 'b', // 5 GB
                q18: 'b', // Sammlung von IAM Users mit gemeinsamen Permissions
                q19: 'c', // IAM
                q20: 'b', // $32/Monat (+ Data Transfer)
                q21: 'b', // IAM Role für die Lambda Function
                q22: 'd', // Alle oben genannten
                q23: 'c', // 90 Tage
                q24: 'a', // Tool zur Visualisierung und Analyse von AWS Kosten
                q25: 'b'  // Alle Ressourcen löschen und ausstehende Rechnungen bezahlen
            };

            let score = 0;
            let total = Object.keys(answers).length;
            let wrongAnswers = [];

            // Alle Fragen durchgehen
            for (let question in answers) {
                const selected = document.querySelector(`input[name="${question}"]:checked`);

                if (selected) {
                    if (selected.value === answers[question]) {
                        score++;
                        // Markiere richtige Antwort grün
                        selected.parentElement.style.color = '#2ecc71';
                        selected.parentElement.style.fontWeight = 'bold';
                    } else {
                        // Markiere falsche Antwort rot
                        selected.parentElement.style.color = '#e74c3c';
                        selected.parentElement.style.fontWeight = 'bold';

                        // Zeige richtige Antwort grün
                        const correctAnswer = document.querySelector(`input[name="${question}"][value="${answers[question]}"]`);
                        if (correctAnswer) {
                            correctAnswer.parentElement.style.color = '#2ecc71';
                            correctAnswer.parentElement.style.fontWeight = 'bold';
                        }

                        wrongAnswers.push(parseInt(question.substring(1)));
                    }
                } else {
                    // Keine Antwort ausgewählt - zeige richtige Antwort
                    const correctAnswer = document.querySelector(`input[name="${question}"][value="${answers[question]}"]`);
                    if (correctAnswer) {
                        correctAnswer.parentElement.style.color = '#667eea';
                        correctAnswer.parentElement.style.fontWeight = 'bold';
                    }
                    wrongAnswers.push(parseInt(question.substring(1)));
                }
            }

            // Prozentsatz berechnen
            const percentage = Math.round((score / total) * 100);

            // Bewertung basierend auf Score
            let rating = '';
            let ratingColor = '';
            let ratingEmoji = '';

            if (percentage >= 90) {
                rating = 'AWS Experte! 🏆';
                ratingColor = '#2ecc71';
                ratingEmoji = '🎉';
            } else if (percentage >= 75) {
                rating = 'Sehr gut! 👍';
                ratingColor = '#27ae60';
                ratingEmoji = '✨';
            } else if (percentage >= 60) {
                rating = 'Gut gemacht! 👌';
                ratingColor = '#f39c12';
                ratingEmoji = '💪';
            } else if (percentage >= 50) {
                rating = 'Noch Übung nötig 📚';
                ratingColor = '#e67e22';
                ratingEmoji = '📖';
            } else {
                rating = 'Wiederhole die Tabs nochmal! 🔄';
                ratingColor = '#e74c3c';
                ratingEmoji = '🔁';
            }

            // Ergebnis anzeigen
            const resultDiv = document.getElementById('quiz-result');
            resultDiv.innerHTML = `
                <div style="background: linear-gradient(135deg, ${ratingColor}22 0%, ${ratingColor}11 100%);
                            border-left: 5px solid ${ratingColor};
                            padding: 30px;
                            border-radius: 12px;
                            box-shadow: 0 4px 20px rgba(0,0,0,0.15);">
                    <h3 style="color: ${ratingColor}; margin-top: 0; font-size: 28px;">
                        ${ratingEmoji} ${rating}
                    </h3>
                    <p style="font-size: 24px; margin: 15px 0;">
                        <strong style="color: #667eea;">Dein Ergebnis: ${score} von ${total} Punkten (${percentage}%)</strong>
                    </p>
                    ${wrongAnswers.length > 0 ? `
                        <p style="margin: 10px 0; color: #e74c3c;">
                            <strong>Falsch beantwortet:</strong> Frage(n) ${wrongAnswers.join(', ')}
                        </p>
                        <p style="margin: 10px 0; font-size: 14px; color: #7f8c8d;">
                            💡 <em>Tipp: Gehe die entsprechenden Tabs nochmal durch!</em>
                        </p>
                    ` : `
                        <p style="margin: 10px 0; color: #2ecc71; font-size: 18px;">
                            <strong>🎯 Perfekt! Alle Fragen richtig beantwortet!</strong>
                        </p>
                    `}
                    <button onclick="resetQuiz()" style="margin-top: 20px; padding: 12px 30px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border: none; border-radius: 8px; font-size: 16px; cursor: pointer; box-shadow: 0 3px 10px rgba(0,0,0,0.2);">
                        🔄 Quiz zurücksetzen
                    </button>
                </div>
            `;

            // Scroll zu Ergebnis
            resultDiv.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        function resetQuiz() {
            // Alle Radio Buttons deselektieren
            const radios = document.querySelectorAll('input[type="radio"]');
            radios.forEach(radio => {
                radio.checked = false;
                radio.parentElement.style.color = '';
                radio.parentElement.style.fontWeight = '';
            });

            // Ergebnis löschen
            document.getElementById('quiz-result').innerHTML = '';

            // Scroll zu Quiz-Start
            document.getElementById('quiz-container').scrollIntoView({ behavior: 'smooth' });
        }
    </script>
    <!-- Cross-Linking zwischen Artefakten -->
    <script src="cross-linking.js"></script>
</body>
</html>
